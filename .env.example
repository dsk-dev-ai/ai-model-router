# Public API key for this gateway (unset = no auth on /v1/*). Set one on deploy.
ROUTER_API_KEY=

# Provider keys — set at least one; the mock provider serves the rest.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional: override endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# Server
# ROUTER_HOST=0.0.0.0
# ROUTER_PORT=8000
# ROUTER_DEFAULT_POLICY=priority   # priority | cheapest | fastest

# Keep mock provider reachable; force it to fail for selected models (tests):
# ROUTER_MOCK_FAIL_MODELS=mock/echo